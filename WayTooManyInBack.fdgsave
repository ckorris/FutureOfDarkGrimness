      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":\"[\\r\\n  {\\r\\n    \\\"requestedName\\\": \\\"Tough(3)\\\",\\r\\n    \\\"definition\\\": {\\r\\n      \\\"name\\\": \\\"Tough\\\",\\r\\n      \\\"passive\\\": [\\r\\n        {\\r\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\r\\n          \\\"condition\\\": {\\r\\n            \\\"kind\\\": \\\"always\\\"\\r\\n          },\\r\\n          \\\"effect\\\": {\\r\\n            \\\"kind\\\": \\\"setMaxWounds\\\",\\r\\n            \\\"amount\\\": {\\r\\n              \\\"kind\\\": \\\"arg\\\",\\r\\n              \\\"index\\\": 0\\r\\n            }\\r\\n          },\\r\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\r\\n          \\\"seat\\\": \\\"Actor\\\"\\r\\n        }\\r\\n      ],\\r\\n      \\\"activated\\\": [],\\r\\n      \\\"scope\\\": \\\"Unit\\\",\\r\\n      \\\"engineArgumentCount\\\": 0,\\r\\n      \\\"valence\\\": \\\"Positive\\\",\\r\\n      \\\"description\\\": \\\"Each model in the unit has multiple wounds instead of one.\\\"\\r\\n    },\\r\\n    \\\"intArguments\\\": [\\r\\n      3\\r\\n    ]\\r\\n  },\\r\\n  {\\r\\n    \\\"requestedName\\\": \\\"Battleborn\\\",\\r\\n    \\\"definition\\\": {\\r\\n      \\\"name\\\": \\\"Battleborn\\\",\\r\\n      \\\"passive\\\": [\\r\\n        {\\r\\n          \\\"hookID\\\": \\\"Round_OnRoundStart\\\",\\r\\n          \\\"condition\\\": {\\r\\n            \\\"kind\\\": \\\"and\\\",\\r\\n            \\\"left\\\": {\\r\\n              \\\"kind\\\": \\\"tokenPresent\\\",\\r\\n              \\\"tType\\\": {\\r\\n                \\\"id\\\": \\\"Shaken\\\"\\r\\n              },\\r\\n              \\\"minCount\\\": 1\\r\\n            },\\r\\n            \\\"right\\\": {\\r\\n              \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\r\\n            }\\r\\n          },\\r\\n          \\\"effect\\\": {\\r\\n            \\\"kind\\\": \\\"clearTokenOnRoll\\\",\\r\\n            \\\"tType\\\": {\\r\\n              \\\"id\\\": \\\"Shake