    "ruleDefinitions": [
      {
        "name": "Unpredictable Shooter Mark",
        "passive": [],
        "activated": [
          {
            "triggerHook": "Activation_OnBeforeAttackAction",
            "cost": {
              "kind": "oncePerActivation"
            },
            "targetSelector": {
              "rangeInches": 18,
              "minCount": 1,
              "maxCount": 1,
              "targetAffinity": "Foe",
              "requireLineOfSight": true,
              "requiredToken": null,
              "singleModel": false,
              "requiredRule": null,
              "maxCountFromArgument": false
            },
            "effect": {
              "kind": "markTarget",
              "ruleName": "Unpredictable Shooter"
            },
            "availableWhen": {
              "kind": "always"
            },
            "label": ""
          }
        ],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight, which friendly units gets Unpredictable Shooter against once (next time the effect would apply)."
      },
      {
        "name": "Mischievous",
        "passive": [
          {
            "hookID": "Shooting_OnSaveRollComplete",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "reroll",
              "roll": "Save",
              "condition": {
                "kind": "onUnmodifiedValue",
                "minValue": 6
              }
            },
            "lifetime": "ThisAttack",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Weapon",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "When attacking, targets must re-roll unmodified Defense results of 6 when blocking hits from this model\u0027s weapons."
      },
      {
        "name": "Bravery Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "aura",
              "ruleName": "Courage"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This model and its unit get \u002B1 to Morale Test rolls."
      },
      {
        "name": "Precision Fighter Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
