    "ruleDefinitions": [
      {
        "name": "Cursed Stride Effect",
        "passive": [
          {
            "hookID": "Movement_OnMoveThroughTerrain",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "countAsInTerrain",
              "terrain": "Dangerous"
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Negative",
        "description": "This unit counts as being in Dangerous Terrain on its next move - the unit rolls a die per wound it would take to destroy it, taking a wound on each 1 (from Cursed Stride)."
      },
      {
        "name": "Spell Resistance",
        "passive": [
          {
            "hookID": "Shooting_OnSaveRollComplete",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "isSpell"
              },
              "right": {
                "kind": "mostModelsHaveThisRule"
              }
            },
            "effect": {
              "kind": "ignoreWoundOnRoll",
              "minRoll": 2
            },
            "lifetime": "ThisAttack",
            "seat": "Subject"
          },
          {
            "hookID": "Shooting_OnSaveRollComplete",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "isNotSpell"
              },
              "right": {
                "kind": "mostModelsHaveThisRule"
              }
            },
            "effect": {
              "kind": "ignoreWoundOnRoll",
              "minRoll": 6
            },
            "lifetime": "ThisAttack",
            "seat": "Subject"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "When a unit where most models have this rule takes wounds, roll one die for each. If the wound was from a spell, then it is ignored on a 2\u002B. If the wound was not from a spell, then it is ignored on a 6\u002B instead."
      },
      {
        "name": "Spell Resistance Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "aura",
              "ruleName": "Spell Resistance"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This model and its unit get Spell Resistance."
      },
      {
        "name": "Havocbound",
        "passive": [
          {
            "hookID": "Shooting_OnHitRollComplete",
            "condition": {
              "kind": "attackingFromOver",
              "shootInches": 9,
              "chargeInches": 6
            },
            "effect": {
              "kind": "rollModifier",
              "rollKind": "Save",
              "delta": -1
            },
            "lifetime": "ThisAttack",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "When this model shoots/charges enemies over 9\u0022/6\u0022 away, its weapons get AP(\u002B1)."
      },
      {
        "name": "Versatile Expert",
        "passive": [],
        "activated": [
