    "ruleDefinitions": [
      {
        "name": "Ranged Slayer Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "aura",
              "ruleName": "Ranged Slayer"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This model and its unit get Ranged Slayer."
      },
      {
        "name": "Targeting Visor",
        "passive": [
          {
            "hookID": "Shooting_OnHitRollModifier",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "not",
                "inner": {
                  "kind": "isMelee"
                }
              },
              "right": {
                "kind": "distanceGreaterThan",
                "distanceInches": 9
              }
            },
            "effect": {
              "kind": "rollModifier",
              "rollKind": "Hit",
              "delta": 1
            },
            "lifetime": "ThisAttack",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "When shooting at enemies over 9\u0022 away, this model gets \u002B1 to hit rolls."
      },
      {
        "name": "Piercing Shooting Mark",
        "passive": [],
        "activated": [
          {
            "triggerHook": "Activation_OnBeforeAttackAction",
            "cost": {
              "kind": "oncePerActivation"
            },
            "targetSelector": {
              "rangeInches": 18,
              "minCount": 1,
              "maxCount": 1,
              "targetAffinity": "Foe",
              "requireLineOfSight": true,
              "requiredToken": null,
              "singleModel": false,
              "requiredRule": null,
              "maxCountFromArgument": false
            },
            "effect": {
              "kind": "markTarget",
              "ruleName": "Piercing Shooting"
            },
            "availableWhen": {
              "kind": "always"
            },
            "label": ""
          }
        ],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight, which friendly units gets AP(\u002B1) on their weapons when shooting against once (next time the effect would apply)."
      },
      {
        "name": "Counter in Melee Aura",
