    "ruleDefinitions": [
      {
        "name": "Shock Speed Effect",
        "passive": [
          {
            "hookID": "Movement_OnMoveActionDeclared",
            "condition": {
              "kind": "actionTypeIs",
              "actionType": "Advance"
            },
            "effect": {
              "kind": "movementBonus",
              "actionType": "Advance",
              "distanceInches": 2,
              "minResultInches": 0
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          },
          {
            "hookID": "Movement_OnMoveActionDeclared",
            "condition": {
              "kind": "actionTypeIs",
              "actionType": "Rush"
            },
            "effect": {
              "kind": "movementBonus",
              "actionType": "Rush",
              "distanceInches": 4,
              "minResultInches": 0
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          },
          {
            "hookID": "Movement_OnMoveActionDeclared",
            "condition": {
              "kind": "actionTypeIs",
              "actionType": "Charge"
            },
            "effect": {
              "kind": "movementBonus",
              "actionType": "Charge",
              "distanceInches": 4,
              "minResultInches": 0
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Moves \u002B2\u0022 when using Advance, and \u002B4\u0022 when using Rush/Charge (from Shock Speed)."
      },
      {
        "name": "Honor Code",
        "passive": [
          {
            "hookID": "Round_OnRoundStart",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Shaken"
                },
                "minCount": 1
              },
              "right": {
                "kind": "mostModelsHaveThisRule"
              }
            },
            "effect": {
              "kind": "clearTokenOnRoll",
              "tType": {
                "id": "Shaken"
              },
              "minRoll": 4
            },
            "lifetime": "ThisRound",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4\u002B, it stops being Shaken."
      },
      {
        "name": "Armor",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "setDefense",
              "defense": {
                "kind": "arg",
                "index": 0
              }
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 1,
        "valence": "Positive",
        "description": "Counts as having Defense X\u002B."
      },
      {
        "name": "Anti-Cover",
        "passive": [
          {
            "hookID": "Shooting_OnSaveRollModifier",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "ignoreCover"
            },
            "lifetime": "ThisAttack",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Weapon",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This weapon ignores Cover."
      },
      {
        "name": "Anti-Regen",
        "passive": [
          {
            "hookID": "Shooting_OnSaveRollComplete",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "ignoreRule",
              "ruleName": "Regeneration"
            },
            "lifetime": "ThisAttack",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Weapon",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This weapon ignores Regeneration."
      },
      {
        "name": "Assault",
        "passive": [
          {
            "hookID": "Lifecycle_OnCapabilityQuery",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "enableMeleeUse"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Weapon",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Counts as both a ranged weapon and a melee weapon."
      }
    ],
