    "ruleDefinitions": [
      {
        "name": "Unstoppable Mark",
        "passive": [],
        "activated": [
          {
            "triggerHook": "Activation_OnBeforeAttackAction",
            "cost": {
              "kind": "oncePerActivation"
            },
            "targetSelector": {
              "rangeInches": 18,
              "minCount": 1,
              "maxCount": 1,
              "targetAffinity": "Foe",
              "requireLineOfSight": true,
              "requiredToken": null,
              "singleModel": false,
              "requiredRule": null,
              "maxCountFromArgument": false
            },
            "effect": {
              "kind": "markTarget",
              "ruleName": "Unstoppable"
            },
            "availableWhen": {
              "kind": "always"
            },
            "label": ""
          }
        ],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight, which friendly units gets Unstoppable on their weapons against once (next time the effect would apply)."
      },
      {
        "name": "Bravery Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "aura",
              "ruleName": "Courage"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This model and its unit get \u002B1 to Morale Test rolls."
      },
      {
        "name": "Versatile Expert",
        "passive": [],
        "activated": [
          {
            "triggerHook": "Activation_OnActivationStart",
            "cost": {
              "kind": "oncePerActivation"
            },
            "targetSelector": {
              "rangeInches": 0,
              "minCount": 1,
              "maxCount": 1,
              "targetAffinity": "Self",
              "requireLineOfSight": false,
              "requiredToken": null,
              "singleModel": false,
              "requiredRule": null,
              "maxCountFromArgument": false
            },
            "effect": {
              "kind": "addRule",
              "ruleName": "Versatile Expert (Piercing)",
              "scope": "ThisActivation"
            },
            "availableWhen": {
              "kind": "always"
            },
            "label": "AP(\u002B1)"
          },
          {
            "triggerHook": "Activation_OnActivationStart",
            "cost": {
              "kind": "oncePerActivation"
            },
            "targetSelector": {
              "rangeInches": 0,
              "minCount": 1,
              "maxCount": 1,
              "targetAffinity": "Self",
              "requireLineOfSight": false,
              "requiredToken": null,
              "singleModel": false,
              "requiredRule": null,
              "maxCountFromArgument": false
            },
            "effect": {
              "kind": "addRule",
              "ruleName": "Versatile Expert (Precision)",
              "scope": "ThisActivation"
            },
            "availableWhen": {
              "kind": "always"
            },
            "label": "\u002B1 to hit"
          }
        ],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "When this unit is activated, pick one effect: until the end of the activation all models with this rule in this unit either get AP(\u002B1) when attacking, or get \u002B1 to hit rolls when attacking."
      },
      {
        "name": "Versatile Reach Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "aura",
              "ruleName": "Versatile Reach"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This model and its unit get Versatile Reach."
      },
      {
        "name": "Battleborn",
        "passive": [
          {
            "hookID": "Round_OnRoundStart",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Shaken"
                },
                "minCount": 1
              },
              "right": {
                "kind": "mostModelsHaveThisRule"
              }
            },
            "effect": {
              "kind": "clearTokenOnRoll",
              "tType": {
                "id": "Shaken"
              },
              "minRoll": 4
            },
            "lifetime": "ThisRound",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4\u002B, it stops being Shaken."
      },
      {
        "name": "Armor",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "setDefense",
              "defense": {
                "kind": "arg",
                "index": 0
              }
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 1,
        "valence": "Positive",
        "description": "Counts as having Defense X\u002B."
      },
