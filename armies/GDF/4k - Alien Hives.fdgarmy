    "ruleDefinitions": [
      {
        "name": "Caster Group",
        "passive": [
          {
            "hookID": "Lifecycle_OnCapabilityQuery",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "enableCasting"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          },
          {
            "hookID": "Round_OnRoundStart",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "grantToken",
              "tType": {
                "id": "SpellTokens"
              },
              "count": {
                "kind": "ruleCarrierCount"
              },
              "clear": {
                "kind": "roundEnd"
              },
              "maxTotal": 0
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Pick one model with this rule in this unit to have Caster(X), where X is the total number of models with this rule in this unit. If the model is killed, pick another to be the new caster, and transfer all spell tokens to it. The caster loses all unspent spell tokens at the end of the round."
      },
      {
        "name": "Spell Conduit",
        "passive": [
          {
            "hookID": "Lifecycle_OnCapabilityQuery",
            "condition": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Shaken"
                },
                "minCount": 1
              }
            },
            "effect": {
              "kind": "enableSpellRelay",
              "rangeInches": 12,
              "castRollBonus": 1
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Casters within 12\u0022 that are from other friendly units may cast spells as if they were in this model\u0027s position, and get \u002B1 to casting rolls when doing so. Friendly casters may only use this rule if this unit isn\u0027t Shaken."
      },
      {
        "name": "Hive Bond",
        "passive": [
          {
            "hookID": "Morale_OnPreMoraleTest",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "attackedFromOver",
                "shootInches": 9,
                "chargeInches": 6
              },
              "right": {
                "kind": "mostModelsHaveThisRule"
              }
            },
            "effect": {
              "kind": "rollModifier",
              "rollKind": "Morale",
              "delta": 1
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "If most models in this unit have this rule, they get \u002B1 to Morale Test rolls when shot/charged from over 9\u0022/6\u0022 away."
      },
      {
        "name": "Predator",
        "passive": [
          {
            "hookID": "Shooting_OnHitRollComplete",
            "condition": {
              "kind": "unmodifiedRollEquals",
              "dieValue": 6
            },
            "effect": {
              "kind": "addExtraHit",
              "onRollValue": 6,
              "count": 1
            },
            "lifetime": "ThisAttack",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "For each unmodified roll of 6 to hit when attacking, this model may roll \u002B1 attack with that weapon. This rule doesn\u0027t apply to newly generated attacks."
      },
      {
        "name": "Predator Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "aura",
              "ruleName": "Predator"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This model and its unit get Predator."
      },
      {
        "name": "Infiltrate",
