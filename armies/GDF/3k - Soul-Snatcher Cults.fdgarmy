    "ruleDefinitions": [
      {
        "name": "Spell Conduit",
        "passive": [
          {
            "hookID": "Lifecycle_OnCapabilityQuery",
            "condition": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Shaken"
                },
                "minCount": 1
              }
            },
            "effect": {
              "kind": "enableSpellRelay",
              "rangeInches": 12,
              "castRollBonus": 1
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Casters within 12\u0022 that are from other friendly units may cast spells as if they were in this model\u0027s position, and get \u002B1 to casting rolls when doing so. Friendly casters may only use this rule if this unit isn\u0027t Shaken."
      },
      {
        "name": "Melee Slayer Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "aura",
              "ruleName": "Melee Slayer"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This model and its unit get Melee Slayer."
      },
      {
        "name": "Precision Shooting Mark",
        "passive": [],
        "activated": [
          {
            "triggerHook": "Activation_OnBeforeAttackAction",
            "cost": {
              "kind": "oncePerActivation"
            },
            "targetSelector": {
              "rangeInches": 18,
              "minCount": 1,
              "maxCount": 1,
              "targetAffinity": "Foe",
              "requireLineOfSight": true,
              "requiredToken": null,
              "singleModel": false,
              "requiredRule": null,
              "maxCountFromArgument": false
            },
            "effect": {
              "kind": "markTarget",
              "ruleName": "Precision Shooting"
            },
            "availableWhen": {
              "kind": "always"
            },
            "label": ""
          }
        ],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight, which friendly units get \u002B1 to hit rolls when shooting against once (next time the effect would apply)."
      },
      {
        "name": "Increased Shooting Range Buff",
        "passive": [],
        "activated": [
          {
            "triggerHook": "Activation_OnBeforeAttackAction",
            "cost": {
              "kind": "oncePerActivation"
            },
            "targetSelector": {
              "rangeInches": 12,
              "minCount": 1,
              "maxCount": 1,
              "targetAffinity": "Friend",
              "requireLineOfSight": false,
              "requiredToken": null,
              "singleModel": false,
              "requiredRule": null,
              "maxCountFromArgument": false
            },
            "effect": {
              "kind": "addRule",
              "ruleName": "Increased Shooting Range",
              "scope": "NextTrigger"
            },
            "availableWhen": {
              "kind": "always"
            },
            "label": ""
          }
        ],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Once per activation, before attacking, pick one friendly unit within 12\u0022, which gets \u002B6\u0022 range on its weapons when shooting once (next time the effect would apply)."
      },
      {
        "name": "Bounding",
        "passive": [
          {
            "hookID": "Activation_OnActivationStart",
            "condition": {
              "kind": "mostModelsHaveThisRule"
            },
            "effect": {
              "kind": "repositionAtActivation",
              "distance": {
                "kind": "d3"
              },
              "plusInches": 1,
              "move": true
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "When this unit is activated, you may move all models with this rule in it by up to D3\u002B1\u0022."
      },
      {
        "name": "Armor",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "setDefense",
              "defense": {
                "kind": "arg",
                "index": 0
              }
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 1,
        "valence": "Positive",
        "description": "Counts as having Defense X\u002B."
      },
      {
        "name": "Speed Buff",
        "passive": [],
        "activated": [
          {
            "triggerHook": "Activation_OnBeforeAttackAction",
            "cost": {
              "kind": "oncePerActivation"
            },
            "targetSelector": {
              "rangeInches": 12,
              "minCount": 1,
              "maxCount": 1,
              "targetAffinity": "Friend",
              "requireLineOfSight": false,
              "requiredToken": null,
              "singleModel": false,
              "requiredRule": null,
              "maxCountFromArgument": false
            },
            "effect": {
              "kind": "addRule",
              "ruleName": "Fast",
              "scope": "NextTrigger"
            },
            "availableWhen": {
              "kind": "always"
            },
            "label": ""
          }
        ],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Once per activation, before attacking, pick one friendly unit within 12\u0022, which moves \u002B2\u0022 when using Advance actions and \u002B4\u0022 when using Rush/Charge actions once (next time the effect would apply)."
      },
      {
        "name": "Grounded Precision Aura",
