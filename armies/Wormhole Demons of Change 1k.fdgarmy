  "ruleDefinitions": [
    {
      "name": "Spell Accumulator",
      "passive": [
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "AccumulatorTokens"
            },
            "count": {
              "kind": "arg",
              "index": 0
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 6
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        },
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "not",
            "inner": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "enableSpellLending",
            "pool": {
              "id": "AccumulatorTokens"
            },
            "rangeInches": 12
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Gets X accumulator tokens at the start of each round, but can\u0027t hold more than 6 tokens at once. Casters from other friendly units within 12\u0022 may spend this unit\u0027s accumulator tokens as if they were their own spell tokens. Friendly casters may only use this rule if this unit isn\u0027t Shaken."
    },
    {
      "name": "Unique",
      "passive": [],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Neutral",
      "description": "Your army may only include one copy of this unit."
    },
    {
      "name": "Ignores Regeneration",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreRule",
            "ruleName": "Regeneration"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon\u0027s attacks ignore the target\u0027s Regeneration."
    },
    {
      "name": "Changebound",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "and",
