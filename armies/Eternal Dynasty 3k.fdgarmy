  "ruleDefinitions": [
    {
      "name": "Unique",
      "passive": [],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Neutral",
      "description": "Your army may only include one copy of this unit."
    },
    {
      "name": "Tear",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "targetMajorityHasTough",
            "minToughValue": 9
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -4
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Against units where most models have Tough 9\u002B, this weapon gets AP(\u002B4)."
    },
    {
      "name": "Clan Warrior",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unmodifiedRollEquals",
            "dieValue": 6
          },
          "effect": {
            "kind": "addExtraHit",
            "onRollValue": 6,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Each unmodified 6 to hit scores an extra hit."
    },
    {
      "name": "Clan Warrior Boost",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "unitHasRule",
              "ruleName": "Clan Warrior"
            },
            "right": {
              "kind": "unmodifiedRollEquals",
              "dieValue": 5
            }
          },
          "effect": {
            "kind": "addExtraHit",
            "onRollValue": 5,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this model has Clan Warrior, unmodified 5s or 6s to hit each score an extra hit (instead of only 6). The base rule already covers the 6s."
    },
    {
      "name": "Clan Warrior Boost Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Clan Warrior Boost"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Clan Warrior Boost."
    },
    {
      "name": "Precision Fighter Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Precision Fighter"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Precision Fighter."
    },
    {
      "name": "Increased Shooting Range Mark",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "markTarget",
            "ruleName": "Increased Shooting Range"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18 inches in line of sight. The first friendly attack against it this activation gets Increased Shooting Range."
    },
    {
      "name": "Ignores Cover Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Ignores Cover when Shooting"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
