  "defaultRangedEffectSet": "laser-beam",
  "defaultMeleeEffectSet": "energy-blade",
  "ruleDefinitions": [
    {
      "name": "Disintegrate",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreRule",
            "ruleName": "Regeneration"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "statGreaterOrEqualTo",
            "stat": "Defense",
            "statValue": 2
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Ignores Regeneration. Against units with Defense 2\u002B, this weapon gets AP(\u002B2)."
    },
    {
      "name": "Ranged Slayer Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Ranged Slayer"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Ranged Slayer."
    },
    {
      "name": "Targeting Visor",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "not",
              "inner": {
                "kind": "isMelee"
              }
            },
            "right": {
              "kind": "distanceGreaterThan",
              "distanceInches": 9
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Hit",
            "delta": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When shooting enemies over 9 inches away, this model gets \u002B1 to hit."
    },
    {
      "name": "Targeting Visor Boost",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "unitHasRule",
              "ruleName": "Targeting Visor"
            },
            "right": {
              "kind": "and",
              "left": {
                "kind": "not",
                "inner": {
                  "kind": "isMelee"
                }
              },
              "right": {
                "kind": "not",
                "inner": {
                  "kind": "distanceGreaterThan",
                  "distanceInches": 9
                }
              }
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Hit",
            "delta": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this model has Targeting Visor, it always gets \u002B1 to hit when shooting (not only over 9 inches away)."
    },
    {
      "name": "Targeting Visor Boost Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Targeting Visor Boost"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Targeting Visor Boost."
    },
    {
      "name": "Piercing Shooting Mark",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
