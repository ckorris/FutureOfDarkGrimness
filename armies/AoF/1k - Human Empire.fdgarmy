  "defaultRangedEffectSet": "ballistic-slug",
  "defaultMeleeEffectSet": "blade-standard",
  "ruleDefinitions": [
    {
      "name": "Caster Group",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "enableCasting"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        },
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "SpellTokens"
            },
            "count": {
              "kind": "ruleCarrierCount"
            },
            "clear": {
              "kind": "roundEnd"
            },
            "maxTotal": 0
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Pick one model with this rule in this unit to have Caster(X), where X is the total number of models with this rule in this unit. If the model is killed, pick another to be the new caster, and transfer all spell tokens to it. The caster loses all unspent spell tokens at the end of the round."
    },
    {
      "name": "Extended Buff Range",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "enableBuffRelay",
            "rangeInches": 12
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this unit is within 24\u0022 of another friendly unit with this rule that has a Hero in it, then that Hero may use special rules that allow it to pick friendly units within 12\u0022 (except for spells) on this unit as if it was in range."
    },
    {
      "name": "Spell Resistance",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isSpell"
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "ignoreWoundOnRoll",
            "minRoll": 2
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        },
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isNotSpell"
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "ignoreWoundOnRoll",
            "minRoll": 6
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When a unit where most models have this rule takes wounds, roll one die for each. If the wound was from a spell, then it is ignored on a 2\u002B. If the wound was not from a spell, then it is ignored on a 6\u002B instead."
    },
    {
      "name": "Precision Fighting Mark",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
