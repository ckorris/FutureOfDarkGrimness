    {
      "name": "Re-Position Artillery",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 6,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Friend",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": "Artillery"
          },
          "effect": {
            "kind": "triggeredMove",
            "maxInches": 9,
            "isOptional": true
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one friendly unit within 6\u0022 with Artillery, which may immediately move by up to 9\u0022."
    },
