<Project>

  <!-- Shared assembly metadata for every project in this checkout, including the
       FutureOfDarkGrimness submodule (MSBuild finds this file by walking up from each
       project directory). SignPath requires Product and product version to be set and
       identical across all binaries in a signed build - keep this the single source of
       truth and don't re-set these properties in individual csproj files. -->
  <PropertyGroup>
    <Product>Future of Dark Grimness</Product>
    <Company>Chris Orris</Company>
    <Authors>Chris Orris</Authors>
    <Copyright>Copyright (c) 2026 Chris Orris</Copyright>
    <Version>0.2.0</Version>
    <RepositoryUrl>https://github.com/ckorris/FutureOfDarkGrimness</RepositoryUrl>
    <!-- #226: the build stamp bug reports carry (see FdgRaylib/AppVersion.cs). Local/IDE
         builds report "<Version>-dev"; dist/CI builds override it on the command line via
         -p:InformationalVersion (a global property, so it wins across all projects). -->
    <InformationalVersion>$(Version)-dev</InformationalVersion>
  </PropertyGroup>

</Project>
