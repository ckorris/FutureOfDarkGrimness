      "JsonValue": "{\"UnitBindings\":[{\"TypeID\":{\"ID\":8},\"Index\":0,\"Generation\":1}],\"_armyRuleDataJson\":\"{\\n  \\\"ruleDefinitions\\\": [\\n    {\\n      \\\"name\\\": \\\"Vinci Tech (Piercing)\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"attackedFromOverInches\\\",\\n            \\\"distanceInches\\\": 9\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Save\\\",\\n            \\\"delta\\\": -1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"AP(\\\\u002B1) when shooting or charging enemies over 9 inches away, for this activation.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Vinci Tech (Precision)\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"attackedFromOverInches\\\",\\n            \\\"distanceInches\\\": 9\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Hit\\\",\\n            \\\"delta\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"\\\\u002B1 to hit when shooting or charging enemies over 9 inches away, for this activation.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Vinci Tech\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActivationStart\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Vinci Tech (Piercing)\\\",\\n            \\\"scope\\\": \\\"ThisActivation\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"AP(\\\\u002B1)\\\"\\n        },\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActivationStart\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Vinci Tech (Precision)\\\",\\n            \\\"scope\\\": \\\"ThisActivation\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\\u002B1 to hit\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When this unit is activated, pick one effect until the end of the activation: when shooting or charging enemies over 9 inches away, it gets either AP(\\\\u002B1) or \\\\u002B1 to hit rolls.\\\"\\n    }\\n  ],\\n  \\\"spells\\\": [],\\n  \\\"auxiliaryUnits\\\": null,\\n  \\\"defaultRangedEffectSet\\\": null,\\n  \\\"defaultMeleeEffectSet\\\": null\\n}\",\"PlayerID\":{\"ID\":\"b8a2ca11-d31e-4e6c-99a5-06983d69a697\"},\"ArmyName\":\"Vinci Tech gate demo\",\"Faction\":\"Duchies of Vinci\",\"PointsLimit\":0}"
