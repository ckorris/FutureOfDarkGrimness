    \\\"name\\\": \\\"Enhanced Vinci Tech\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"and\\\",\\n            \\\"left\\\": {\\n              \\\"kind\\\": \\\"unitHasRule\\\",\\n              \\\"ruleName\\\": \\\"Vinci Tech (Piercing)\\\"\\n            },\\n            \\\"right\\\": {\\n              \\\"kind\\\": \\\"and\\\",\\n              \\\"left\\\": {\\n                \\\"kind\\\": \\\"not\\\",\\n                \\\"inner\\\": {\\n                  \\\"kind\\\": \\\"attackingFromOver\\\",\\n                  \\\"shootInches\\\": 9,\\n                  \\\"chargeInches\\\": 6\\n                }\\n              },\\n              \\\"right\\\": {\\n                \\\"kind\\\": \\\"isNotSpell\\\"\\n              }\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Save\\\",\\n            \\\"delta\\\": -1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"and\\\",\\n            \\\"left\\\": {\\n              \\\"kind\\\": \\\"unitHasRule\\\",\\n              \\\"ruleName\\\": \\\"Vinci Tech (Precision)\\\"\\n            },\\n            \\\"right\\\": {\\n              \\\"kind\\\": \\\"not\\\",\\n              \\\"inner\\\": {\\n                \\\"kind\\\": \\\"attackingFromOver\\\",\\n                \\\"shootInches\\\": 9,\\n                \\\"chargeInches\\\": 6\\n              }\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Hit\\\",\\n            \\\"delta\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"If this model has Versatile Attack, it always gets either AP(\\\\u002B1) or \\\\u002B1 to hit rolls from Versatile Attack (instead of only when shooting/charging enemies over 9\\\\u0022/6\\\\u0022 away).\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Enhanced Vinci Tech Aura\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"aura\\\",\\n            \\\"ruleName\\\": \\\"Enhanced Vinci Tech\\\"\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"This model and its unit get Enhanced Vinci Tech.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Ranged Slayer\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"and\\\",\\n            \\\"left\\\": {\\n              \\\"kind\\\": \\\"not\\\",\\n              \\\"inner\\\": {\\n                \\\"kind\\\": \\\"isMelee\\\"\\n              }\\n            },\\n            \\\"right\\\": {\\n              \\\"kind\\\": \\\"and\\\",\\n              \\\"left\\\": {\\n                \\\"kind\\\": \\\"not\\\",\\n                \\\"inner\\\": {\\n                  \\\"kind\\\": \\\"afterMoving\\\"\\n                }\\n              },\\n              \\\"right\\\": {\\n                \\\"kind\\\": \\\"and\\\",\\n                \\\"left\\\": {\\n                  \\\"kind\\\": \\\"isNotSpell\\\"\\n                },\\n                \\\"right\\\": {\\n                  \\\"kind\\\": \\\"targetMajorityHasTough\\\",\\n                  \\\"minToughValue\\\": 3\\n                }\\n              }\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Save\\\",\\n            \\\"delta\\\": -2\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When using Hold actions and shooting, this model\\\\u0027s weapons get AP(\\\\u002B2) if most models in the target have Tough(3) or higher.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Vinci Tech (Piercing)\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"attackingFromOver\\\",\\n            \\\"shootInches\\\": 9,\\n            \\\"chargeInches\\\": 6\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Save\\\",\\n            \\\"delta\\\": -1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"AP(\\\\u002B1) when shooting/charging enemies over 9\\\\u0022/6\\\\u0022 away, for this activation.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Vinci Tech (Precision)\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"attackingFromOver\\\",\\n            \\\"shootInches\\\": 9,\\n            \\\"chargeInches\\\": 6\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Hit\\\",\\n            \\\"delta\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"\\\\u002B1 to hit rolls when shooting/charging enemies over 9\\\\u0022/6\\\\u0022 away, for this activation.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Vinci Tech\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActivationStart\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null,\\n            \\\"maxCountFromArgument\\\": false\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Vinci Tech (Piercing)\\\",\\n            \\\"scope\\\": \\\"ThisActivation\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"AP(\\\\u002B1)\\\"\\n        },\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActivationStart\\\",\\n          \\