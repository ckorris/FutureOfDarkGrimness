      "JsonValue": "{\"UnitBindings\":[{\"TypeID\":{\"ID\":8},\"Index\":0,\"Generation\":1},{\"TypeID\":{\"ID\":8},\"Index\":1,\"Generation\":1}],\"_armyRuleDataJson\":\"{\\n  \\\"ruleDefinitions\\\": [\\n    {\\n      \\\"name\\\": \\\"Melee Slayer\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"and\\\",\\n            \\\"left\\\": {\\n              \\\"kind\\\": \\\"isCharging\\\"\\n            },\\n            \\\"right\\\": {\\n              \\\"kind\\\": \\\"targetMajorityHasTough\\\",\\n              \\\"minToughValue\\\": 3\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Save\\\",\\n            \\\"delta\\\": -2\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When charging, this model\\\\u0027s weapons get AP(\\\\u002B2) if most models in the target have Tough(3) or higher.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Primeborn\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"mostModelsHaveThisRule\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"reduceArmorPenetration\\\",\\n            \\\"amount\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Subject\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When units where most models have this rule take hits, those hits count as having AP(-1), to a min. of AP(0).\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Unstoppable Mark\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnBeforeAttackAction\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 18,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Foe\\\",\\n            \\\"requireLineOfSight\\\": true,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null,\\n            \\\"maxCountFromArgument\\\": false\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"markTarget\\\",\\n            \\\"ruleName\\\": \\\"Unstoppable\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Once per activation, before attacking, pick one enemy unit within 18\\\\u0022 in line of sight, which friendly units gets Unstoppable on their weapons against once (next time the effect would apply).\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Bravery Aura\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"aura\\\",\\n            \\\"ruleName\\\": \\\"Courage\\\"\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"This model and its unit get \\\\u002B1 to Morale Test rolls.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Versatile Expert\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActivationStart\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null,\\n            \\\"maxCountFromArgument\\\": false\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Versatile Expert (Piercing)\\\",\\n            \\\"scope\\\": \\\"ThisActivation\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"AP(\\\\u002B1)\\\"\\n        },\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActivationStart\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null,\\n            \\\"maxCountFromArgument\\\": false\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Versatile Expert (Precision)\\\",\\n            \\\"scope\\\": \\\"ThisActivation\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\\u002B1 to hit\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When this unit is activated, pick one effect: until the end of the activation all models with this rule in this unit either get AP(\\\\u002B1) when attacking, or get \\\\u002B1 to hit rolls when attacking.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Versatile Reach Aura\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"aura\\\",\\n            \\\"ruleName\\\": \\\"Versatile Reach\\\"\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"This model and its unit get Versatile Reach.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Armor\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"setDefense\\\",\\n            \\\"defense\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 1,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Counts as having Defense X\\\\u002B.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Anti-Cover\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnSaveRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignoreCover\\\"\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"This weapon ignores Cover.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Pierce\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnSaveRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignoreCover\\\"\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignorePositiveDefenseModifiers\\\"\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"targetOverHalfWeaponRange\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Save\\\",\\n            \\\"delta\\\": -1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Ignores all positive Defense modifiers on the target, and when attacking units over half of this weapon\\\\u0027s range away, this weapon gets AP(\\\\u002B1).\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Assault\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnCapabilityQuery\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"enableMeleeUse\\\"\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Counts as both a ranged weapon and a melee weapon.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Versatile Expert (Piercing)\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"isNotSpell\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Save\\\",\\n            \\\"delta\\\": -1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"AP(\\\\u002B1) when attacking, for this activation.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Versatile Expert (Precision)\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Hit\\\",\\n            \\\"delta\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"\\\\u002B1 to hit rolls when attacking, for this activation.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Versatile Reach\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActivationStart\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null,\\n            \\\"maxCountFromArgument\\\": false\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Versatile Reach (Range)\\\",\\n            \\\"scope\\\": \\\"ThisActivation\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\\u002B4in shooting range\\\"\\n        },\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActivationStart\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null,\\n            \\\"maxCountFromArgument\\\": false\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Versatile Reach (Charge)\\\",\\n            \\\"scope\\\": \\\"ThisActivation\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\\u002B2in when charging\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When this unit is activated, pick one effect: until the end of the activation, all models with this rule in this unit either get \\\\u002B4\\\\u0022 range when shooting or move \\\\u002B2\\\\u0022 when charging.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Versatile Reach (Range)\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnRangeCheck\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rangeModifier\\\",\\n            \\\"delta\\\": 4,\\n            \\\"minResultInches\\\": 0,\\n            \\\"chargeDelta\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n     