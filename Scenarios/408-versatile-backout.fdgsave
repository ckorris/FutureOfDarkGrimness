n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnBeforeAttackAction\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 12,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Friend\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Bane in melee\\\",\\n            \\\"scope\\\": \\\"NextTrigger\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Once per activation, before attacking, pick one friendly unit within 12 inches, which gains Bane in melee for its next relevant roll.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Armor\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"setDefense\\\",\\n            \\\"defense\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 1,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Counts as having Defense X\\\\u002B in place of the model\\\\u0027s own Defense stat.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Morale Debuff\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnBeforeAttackAction\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 18,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Foe\\\",\\n            \\\"requireLineOfSight\\\": true,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"statModifier\\\",\\n            \\\"roll\\\": \\\"Morale\\\",\\n            \\\"delta\\\": -1,\\n            \\\"lifetimeScope\\\": \\\"NextTrigger\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Once per activation, before attacking, pick one enemy unit within 18\\\\u0022 in line of sight, which gets -1 to morale test rolls once (next time the effect would apply).\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Mobile Artillery\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"and\\\",\\n            \\\"left\\\": {\\n              \\\"kind\\\": \\\"not\\\",\\n              \\\"inner\\\": {\\n                \\\"kind\\\": \\\"isMelee\\\"\\n              }\\n            },\\n            \\\"right\\\": {\\n              \\\"kind\\\": \\\"and\\\",\\n              \\\"left\\\": {\\n                \\\"kind\\\": \\\"not\\\",\\n                \\\"inner\\\": {\\n                  \\\"kind\\\": \\\"afterMoving\\\"\\n                }\\n              },\\n              \\\"right\\\": {\\n                \\\"kind\\\": \\\"attackedFromOverInches\\\",\\n                \\\"distanceInches\\\": 9\\n              }\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Hit\\\",\\n            \\\"delta\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"and\\\",\\n            \\\"left\\\": {\\n              \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\n            },\\n            \\\"right\\\": {\\n              \\\"kind\\\": \\\"and\\\",\\n              \\\"left\\\": {\\n                \\\"kind\\\": \\\"not\\\",\\n                \\\"inner\\\": {\\n                  \\\"kind\\\": \\\"tokenPresent\\\",\\n                  \\\"tType\\\": {\\n                    \\\"id\\\": \\\"MovedThisRound\\\"\\n                  },\\n                  \\\"minCount\\\": 1\\n                }\\n              },\\n              \\\"right\\\": {\\n                \\\"kind\\\": \\\"distanceGreaterThan\\\",\\n                \\\"distanceInches\\\": 9\\n              }\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Hit\\\",\\n            \\\"delta\\\": -2\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Subject\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When this unit uses a Hold action and shoots at enemies over 9 inches away, it gets \\\\u002B1 to hit rolls. As long as this unit hasn\\\\u0027t moved during the round, when enemies shoot at it from over 9 inches away, they get -2 to hit rolls.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Repel Ambushers\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnCapabilityQuery\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"repelAmbushers\\\",\\n            \\\"distanceInches\\\": 12\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Enemy units using Ambush must be set up over 12\\\\u0022 away from this model\\\\u0027s unit.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"No Retreat Buff\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnBeforeAttackAction\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 12,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Friend\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"No Retreat\\\",\\n            \\\"scope\\\": \\\"NextTrigger\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Once per activation, before attacking, pick one friendly unit within 12\\\\u0022, which gets No Retreat once (next time the effect would apply).\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Coordinate\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnEndOfActivation\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"free\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 12,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Friend\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"activateUnitNext\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"not\\\",\\n            \\\"inner\\\": {\\n              \\\"kind\\\": \\\"tokenPresent\\\",\\n              \\\"tType\\\": {\\n                \\\"id\\\": \\\"ActivatedOutOfOrder\\\"\\n              },\\n              \\\"minCount\\\": 1\\n            }\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"At the end of this unit\\\\u0027s activation, another friendly unit within 12\\\\u0022 that hasn\\\\u0027t activated yet may be activated immediately. May not be used if this unit was activated via Coordinate.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Entrenched\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Save\\\",\\n            \\\"delta\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Subject\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"This unit gets \\\\u002B1 to defense rolls.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Precision Shooter\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"not\\\",\\n            \\\"inner\\\": {\\n              \\\"kind\\\": \\\"isMelee\\\"\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Hit\\\",\\n            \\\"delta\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"\\\\u002B1 to hit rolls when shooting.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"No Retreat\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Morale_OnMoraleTestComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"mostModelsHaveThisRule\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"passFailedMoraleTest\\\",\\n            \\\"selfWoundOnRollAtMost\\\": 3\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When a unit where most models have this rule fails a morale test that causes it to be Shaken or Routed, the test counts as passed instead. Then, roll as many dice as the number of wounds it would take to fully destroy it, and for each result of 1-3 the unit takes one wound, which can\\\\u0027t be ignored.\\\"\\n    }\\n  ],\\n  \\\"spells\\\": [],\\n  \\\"auxiliaryUnits\\\": null,\\n  \\\"defaultRangedEffectSet\\\": null,\\n  \\\"defaultMeleeEffectSet\\\": null\\n}\",\"PlayerID\":{\"ID\":\"33f2ead9-cf2e-44fa-88dc-4363e9e39968\"},\"ArmyName\":\"408 Versatile + 407 Weapon Team\",\"Faction\":\"Prime Brothers\",\"PointsLimit\":0}"
