st\\\": {\\n            \\\"kind\\\": \\\"oncePerGame\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 6,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Foe\\\",\\n            \\\"requireLineOfSight\\\": true,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"dealPooledHits\\\",\\n            \\\"diceCount\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            },\\n            \\\"successThreshold\\\": 2,\\n            \\\"armorPenetration\\\": 1\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 1,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Counts as having Infiltrate. The first time this unit is activated, pick one enemy unit within 6\\\\u0022 in line of sight and roll X dice; for each 2\\\\u002B it takes one hit with AP(1).\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Regenerative Strength\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnWoundIgnored\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"grantIgnoredWoundMarker\\\",\\n            \\\"tType\\\": {\\n              \\\"id\\\": \\\"RegenerativeStrengthMarker\\\"\\n            },\\n            \\\"clear\\\": {\\n              \\\"kind\\\": \\\"manualOnly\\\"\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Subject\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Place one marker on this model when it ignores a wound. When in melee, pick one of its weapons to get \\\\u002BX attacks, where X is the number of markers on it.\\\"\\n    }\\n  ],\\n  \\\"spells\\\": [\\n    {\\n      \\\"name\\\": \\\"Animate Spirit\\\",\\n      \\\"threshold\\\": 1,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 12,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 1,\\n        \\\"targetAffinity\\\": \\\"Friend\\\",\\n        \\\"requireLineOfSight\\\": false,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"addRule\\\",\\n        \\\"ruleName\\\": \\\"Hit \\\\u0026 Run Fighter\\\",\\n        \\\"scope\\\": \\\"NextTrigger\\\"\\n      }\\n    },\\n    {\\n      \\\"name\\\": \\\"Overwhelming Strike\\\",\\n      \\\"threshold\\\": 1,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 12,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 1,\\n        \\\"targetAffinity\\\": \\\"Foe\\\",\\n        \\\"requireLineOfSight\\\": true,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"dealHits\\\",\\n        \\\"count\\\": 2,\\n        \\\"withRules\\\": [\\n          \\\"Destructive\\\"\\n        ],\\n        \\\"armorPenetration\\\": 1\\n      }\\n    },\\n    {\\n      \\\"name\\\": \\\"Infuse Bloodthirst\\\",\\n      \\\"threshold\\\": 2,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 12,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 2,\\n        \\\"targetAffinity\\\": \\\"Friend\\\",\\n        \\\"requireLineOfSight\\\": false,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\