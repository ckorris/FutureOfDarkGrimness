      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":null,\"RemainingWoundsBinding\":{\"TypeID\":{\"ID\":2},\"Index\":102,\"Generation\":1},\"PositionBinding\":{\"TypeID\":{\"ID\":4},\"Index\":102,\"Generation\":1},\"FacingBinding\":{\"TypeID\":{\"ID\":15},\"Index\":102,\"Generation\":1},\"Weapons\":[{\"_ruleDefinitionsJson\":null,\"Name\":\"Razor Claws\",\"RangeInches\":0.0,\"Attacks\":2,\"ArmorPenetration\":0,\"EffectKey\":\"claw-rend\"},{\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Bane\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Bane\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnSaveRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"reroll\\\",\\n            \\\"roll\\\": \\\"Save\\\",\\n            \\\"condition\\\": {\\n              \\\"kind\\\": \\\"onUnmodifiedValue\\\",\\n              \\\"minValue\\\": 6\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnSaveRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignoreRule\\\",\\n            \\\"ruleName\\\": \\\"Regeneration\\\"\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"The defender must re-roll unmodified Defense 6s, and the attack ignores Regeneration.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Precise\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Precise\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Hit\\\",\\n            \\\"delta\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"\\\\u002B1 to hit when attacking with this weapon, in melee or shooting.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  }\\n]\",\"Name\":\"Razor Whip\",\"RangeInches\":0.0,\"Attacks\":2,\"ArmorPenetration\":0,\"EffectKey\":\"claw-rend\"}],\"ID\":{\"ID\":\"8b50ed0d-f45c-486f-b9fa-14a7f96b807a\"},\"TotalWounds\":3.0,\"WoundsDealt\":0.0,\"Position\":{\"Position3D\":{\"X\":32.692127,\"Y\":0.0,\"Z\":20.2074,\"XY\":{\"X\":32.692127,\"Y\":0.0},\"XZ\":{\"X\":32.692127,\"Y\":20.2074}},\"Position2D\":{\"X\":32.692127,\"Y\":20.2074},\"x\":32.692127,\"y\":0.0,\"z\":20.2074},\"Facing\":{\"X\":0.0,\"Y\":1.0},\"BaseShape\":{\"$type\":\"baseShape.circle\",\"RadiusInches\":0.78740156,\"BoundingRadiusInches\":0.78740156,\"CircumscribedRadiusInches\":0.78740156}}"
