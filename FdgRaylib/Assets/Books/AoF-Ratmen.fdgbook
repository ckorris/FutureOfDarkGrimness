  "ruleDefinitions": [
    {
      "name": "Spell Conduit",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "not",
            "inner": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "enableSpellRelay",
            "rangeInches": 12,
            "castRollBonus": 1
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Casters within 12\u0022 that are from other friendly units may cast spells as if they were in this model\u0027s position, and get \u002B1 to casting rolls when doing so. Friendly casters may only use this rule if this unit isn\u0027t Shaken."
    },
    {
      "name": "Melee Slayer",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isCharging"
            },
            "right": {
              "kind": "targetMajorityHasTough",
              "minToughValue": 3
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When charging, this model\u0027s weapons get AP(\u002B2) if most models in the target have Tough(3) or higher."
    },
    {
      "name": "Spell Resistance",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isSpell"
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "ignoreWoundOnRoll",
            "minRoll": 2
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        },
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isNotSpell"
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "ignoreWoundOnRoll",
            "minRoll": 6
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When a unit where most models have this rule takes wounds, roll one die for each. If the wound was from a spell, then it is ignored on a 2\u002B. If the wound was not from a spell, then it is ignored on a 6\u002B instead."
    },
    {
      "name": "Scurry",
