            "placementRangeInches": 3,
            "minArrivalRound": 2,
            "mandatoryArrival": false,
            "enemyClearanceInches": 0
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Counts as having Ambush, but may be deployed anywhere over 3\u0022 away from enemy unit."
    },
