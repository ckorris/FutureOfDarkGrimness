      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Place one token on this unit at the beginning of each round if it\u0027s on the table and isn\u0027t Shaken, up to a max. of four tokens. For every two tokens, models with this rule in this unit get \u002B1 to hit rolls."
    },
