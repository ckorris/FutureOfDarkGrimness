  "ruleDefinitions": [
    {
      "name": "Cursed Stride Effect",
      "passive": [
        {
          "hookID": "Movement_OnMoveThroughTerrain",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "countAsInTerrain",
            "terrain": "Dangerous"
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Negative",
      "description": "This unit counts as being in Dangerous Terrain on its next move - each moving model rolls a d6, taking a wound on a 1 (from Cursed Stride)."
    },
    {
      "name": "Breath Attack",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 6,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "dealHits",
            "count": 1,
            "withRules": [
              "Blast(3)"
            ],
            "armorPenetration": 1
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, one enemy unit within 6\u0022 in line of sight takes 1 hit with Blast(3) and AP(1)."
    },
    {
      "name": "Havocbound",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "or",
            "left": {
              "kind": "and",
              "left": {
                "kind": "not",
                "inner": {
                  "kind": "isMelee"
                }
              },
              "right": {
                "kind": "distanceGreaterThan",
                "distanceInches": 9
              }
            },
            "right": {
              "kind": "isCharging"
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When shooting enemies over 9 inches away, or when charging, this model\u0027s weapons get AP(\u002B1)."
    },
