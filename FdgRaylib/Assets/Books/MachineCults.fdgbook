  "ruleDefinitions": [
    {
      "name": "Corrode Weapons Effect",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "not",
              "inner": {
                "kind": "isMelee"
              }
            },
            "right": {
              "kind": "isNotSpell"
            }
          },
          "effect": {
            "kind": "reduceArmorPenetration",
            "amount": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Negative",
      "description": "This unit\u0027s shooting has its AP reduced by 1, to a minimum of AP(0) (from Corrode Weapons)."
    },
    {
      "name": "Melee Slayer",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isCharging"
            },
            "right": {
              "kind": "targetMajorityHasTough",
              "minToughValue": 3
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When charging, this model\u0027s weapons get AP(\u002B2) if most models in the target have Tough(3) or higher."
    },
    {
      "name": "Machine-Fog",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "attackedFromOver",
              "shootInches": 9,
              "chargeInches": 6
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Hit",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have this rule, enemy units shooting/charging them from over 9\u0022/6\u0022 away get -1 to hit rolls."
    },
    {
      "name": "Rending when Shooting Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Rending when shooting"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get Rending on its weapons when shooting."
    },
    {
      "name": "Versatile Warrior",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnActivationStart",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 0,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Self",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null,
            "maxCountFromArgument": false
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Versatile Warrior (Piercing)",
            "scope": "ThisActivation"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": "AP(\u002B1)"
        },
        {
          "triggerHook": "Activation_OnActivationStart",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 0,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Self",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null,
            "maxCountFromArgument": false
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Versatile Warrior (Precision)",
            "scope": "ThisActivation"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": "\u002B1 to hit"
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this unit is activated, pick one effect: until the end of the activation, when shooting/charging enemies over 9\u0022/6\u0022 away, all models with this rule in it either get AP(\u002B1) or get \u002B1 to hit rolls."
    },
    {
      "name": "Bounding",
      "passive": [
        {
          "hookID": "Activation_OnActivationStart",
          "condition": {
            "kind": "mostModelsHaveThisRule"
          },
          "effect": {
            "kind": "repositionAtActivation",
            "distance": {
              "kind": "d3"
            },
            "plusInches": 1,
            "move": true
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this unit is activated, you may move all models with this rule in it by up to D3\u002B1\u0022."
    },
    {
      "name": "Armor",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "setDefense",
            "defense": {
              "kind": "arg",
              "index": 0
            }
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Counts as having Defense X\u002B."
    },
    {
