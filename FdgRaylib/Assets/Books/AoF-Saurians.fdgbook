  "ruleDefinitions": [
    {
      "name": "Spell Conduit",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "not",
            "inner": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "enableSpellRelay",
            "rangeInches": 12,
            "castRollBonus": 1
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Casters within 12\u0022 that are from other friendly units may cast spells as if they were in this model\u0027s position, and get \u002B1 to casting rolls when doing so. Friendly casters may only use this rule if this unit isn\u0027t Shaken."
    },
    {
      "name": "Primal",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unmodifiedRollEquals",
            "dieValue": 6
          },
          "effect": {
            "kind": "addExtraHit",
            "onRollValue": 6,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "For each unmodified roll of 6 to hit when attacking, this model may roll \u002B1 attack with that weapon. This rule doesn\u0027t apply to newly generated attacks."
    },
    {
      "name": "Shred Mark",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null,
            "maxCountFromArgument": false
          },
          "effect": {
            "kind": "markTarget",
            "ruleName": "Shred"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight, which friendly units gets Shred on their weapons when attacking against once (next time the effect would apply)."
    },
    {
      "name": "Counter in Melee Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Counter"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get Counter on its weapons in melee."
    },
    {
      "name": "Versatile Warrior",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnActivationStart",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 0,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Self",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null,
            "maxCountFromArgument": false
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Versatile Warrior (Piercing)",
            "scope": "ThisActivation"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": "AP(\u002B1)"
        },
        {
          "triggerHook": "Activation_OnActivationStart",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 0,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Self",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null,
            "maxCountFromArgument": false
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Versatile Warrior (Precision)",
            "scope": "ThisActivation"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": "\u002B1 to hit"
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this unit is activated, pick one effect: until the end of the activation, when shooting/charging enemies over 9\u0022/6\u0022 away, all models with this rule in it either get AP(\u002B1) or get \u002B1 to hit rolls."
    },
    {
      "name": "Versatile Warrior Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Versatile Warrior"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get Versatile Warrior."
    },
    {
      "name": "Steadfast",
      "passive": [
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "clearTokenOnRoll",
            "tType": {
              "id": "Shaken"
            },
            "minRoll": 4
          },
          "lifetime": "ThisRound",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4\u002B, it stops being Shaken."
    },
    {
      "name": "Bounding",
      "passive": [
        {
          "hookID": "Activation_OnActivationStart",
          "condition": {
            "kind": "mostModelsHaveThisRule"
          },
          "effect": {
            "kind": "repositionAtActivation",
            "distance": {
              "kind": "d3"
            },
            "plusInches": 1,
            "move": true
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this unit is activated, you may move all models with this rule in it by up to D3\u002B1\u0022."
    },
    {
      "name": "Banner",
      "passive": [
        {
          "hookID": "Morale_OnPreMoraleTest",
