      "valence": "Positive",
      "description": "This model and its unit move \u002B1\u0022 when using move actions."
    },
    {
      "name": "Sergeant",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model gets AP(\u002B1) when attacking."
    },
    {
      "name": "Armor",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "setDefense",
            "defense": {
              "kind": "arg",
              "index": 0
            }
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Counts as having Defense X\u002B."
    },
    {
      "name": "Defensive Frenzy",
      "passive": [
        {
          "hookID": "Shooting_OnUnitDestroyed",
          "condition": {
            "kind": "mostModelsHaveThisRule"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "DefensiveFrenzyMarker"
            },
            "count": {
              "kind": "literal",
              "value": 1
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 2
          },
          "lifetime": "ThisRound",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "mostModelsHaveThisRule"
            },
            "right": {
              "kind": "tokenPresent",
              "tType": {
                "id": "DefensiveFrenzyMarker"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "tokenScaledRollModifier",
            "tType": {
              "id": "DefensiveFrenzyMarker"
            },
            "rollKind": "Save",
            "delta": 1,
            "perMarkers": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have this rule, place one token on this unit when it fully destroys an enemy unit, up to a max. of two tokens. For each token this unit gets \u002B1 to Defense rolls until the end of the game."
    },
    {
      "name": "Repel Ambushers",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "always"
          },
