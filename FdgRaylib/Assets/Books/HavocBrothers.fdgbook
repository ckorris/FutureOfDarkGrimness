  "ruleDefinitions": [
    {
      "name": "Cursed Stride Effect",
      "passive": [
        {
          "hookID": "Movement_OnMoveThroughTerrain",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "countAsInTerrain",
            "terrain": "Dangerous"
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Negative",
      "description": "This unit counts as being in Dangerous Terrain on its next move - each moving model rolls a d6, taking a wound on a 1 (from Cursed Stride)."
    },
    {
      "name": "Havocbound",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "or",
            "left": {
              "kind": "and",
              "left": {
                "kind": "not",
                "inner": {
                  "kind": "isMelee"
                }
              },
              "right": {
                "kind": "distanceGreaterThan",
                "distanceInches": 9
              }
            },
            "right": {
              "kind": "isCharging"
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When shooting enemies over 9 inches away, or when charging, this model\u0027s weapons get AP(\u002B1)."
    },
    {
      "name": "Havocbound Boost",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unitHasRule",
            "ruleName": "Havocbound"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this model has Havocbound, it always gets AP(\u002B1) (not only when shooting over 9 inches away, or when charging)."
    },
    {
      "name": "Havocbound Boost Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Havocbound Boost"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Havocbound Boost."
    }
  ],
