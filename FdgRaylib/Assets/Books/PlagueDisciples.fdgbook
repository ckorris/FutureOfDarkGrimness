      "valence": "Positive",
      "description": "This model and its unit get Spell Resistance."
    },
    {
      "name": "Versatile Expert",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnActivationStart",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 0,
            "minCount": 1,
            "maxCount": 1,
