            "scope": "ThisActivation"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": "\u002B1 to hit"
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this unit is activated, pick one effect: until the end of the activation all models with this rule in this unit either get AP(\u002B1) when attacking, or get \u002B1 to hit rolls when attacking."
    },
