        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This unit always gets \u002B1 to defense rolls (boosted, no range gate)."
    },
