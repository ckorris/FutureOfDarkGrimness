            "kind": "statModifier",
            "roll": "Save",
            "delta": -1,
            "lifetimeScope": "NextTrigger"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight, which gets -1 to Defense rolls once (next time the effect would apply)."
    },
