      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight, which friendly units get \u002B6\u0022 range on their weapons when shooting against once (next time the effect would apply)."
    },
    {
      "name": "Quick Throw",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "weaponHasRule",
            "ruleName": "Indirect"
          },
          "effect": {
            "kind": "ignoreLineOfSight"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model may always target enemies that are not in line of sight when shooting with Indirect weapons (instead of only when using Hold actions)."
    },
    {
      "name": "Steadfast",
      "passive": [
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "clearTokenOnRoll",
            "tType": {
              "id": "Shaken"
            },
            "minRoll": 4
          },
          "lifetime": "ThisRound",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4\u002B, it stops being Shaken."
    },
