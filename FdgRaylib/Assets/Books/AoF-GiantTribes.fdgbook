            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Gets AP(\u002B1) on its weapons in melee."
    }
