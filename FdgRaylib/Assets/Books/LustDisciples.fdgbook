            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Moves moves \u002B1 inches on Advance and \u002B3 inches on Rush/Charge."
    },
    {
      "name": "Lustbound Boost",
      "passive": [
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "actionTypeIs",
              "actionType": "Advance"
            },
            "right": {
              "kind": "unitHasRule",
              "ruleName": "Lustbound"
            }
          },
