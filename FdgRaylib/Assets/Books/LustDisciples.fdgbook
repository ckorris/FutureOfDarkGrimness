            "actionType": "Charge",
            "distanceInches": 3,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this model has Lustbound, it moves \u002B2 inches on Advance and \u002B6 inches on Rush/Charge (instead of only \u002B1 and \u002B3)."
    },
    {
      "name": "Lustbound Boost Aura",
