    {
      "name": "Angelic Blessing",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "ignoreWoundOnRoll",
            "minRoll": 6
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        },
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isSpell"
            },
            "right": {
              "kind": "allModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "ignoreWoundOnRoll",
            "minRoll": 4
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
