oll\\\": \\\"Morale\\\",\\n            \\\"condition\\\": {\\n              \\\"kind\\\": \\\"allFailures\\\"\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When this unit fails a morale test, it re-rolls and passes on a 4\\\\u002B.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Bane when Shooting Aura\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Bane when Shooting Aura\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"aura\\\",\\n            \\\"ruleName\\\": \\\"Bane when shooting\\\"\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Neutral\\\",\\n      \\\"description\\\": \\\"This model and its whole unit gain Bane when shooting.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Disembark\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Disembark\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActionChoice\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n        