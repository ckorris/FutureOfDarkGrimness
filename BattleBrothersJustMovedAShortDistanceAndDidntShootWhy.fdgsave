      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Tough(3)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Tough\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"setMaxWounds\\\",\\n            \\\"amount\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Each model in the unit has multiple wounds instead of one.\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      3\\n    ],\\n    \\\"arguments\\\": [\\n      {\\n        \\\"intValue\\\": 3,\\n        \\\"strValue\\\": null\\n      }\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Highborn\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Highborn\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveActionDeclared\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"actionTypeIs\\\",\\n            \\\"actionType\\\": \\\"Advance\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"movementBonus\\\",\\n            \\\"actionType\\\": \\\"Advance\\\",\\n            \\\"distanceInches\\\": 2,\\n            \\\"minResultInches\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveActionDeclared\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"actionTypeIs\\\",\\n            \\\"actionType\\\": \\\"Rush\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"movementBonus\\\",\\n            \\\"actionType\\\": \\\"Rush\\\",\\n            \\\"distanceInches\\\": 2,\\n            \\\"minResultInches\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveActionDeclared\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"actionTypeIs\\\",\\n            \\\"actionType\\\": \\\"Charge\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"movementBonus\\\",\\n            \\\"actionType\\\": \\\"Charge\\\",\\n            \\\"distanceInches\\\": 2,\\n            \\\"minResultInches\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Moves \\\\u002B2\\\\u0022 when using Advance, and \\\\u002B2\\\\u0022 when using Rush/Charge.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Shielded\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Shielded\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"and\\\",\\n            \\\"left\\\": {\\n              \\\"kind\\\": \\\"isNotSpell\\\"\\n            },\\n            \\\"right\\\": {\\n              \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Save\\\",\\n            \\\"delta\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Subject\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"\\\\u002B1 to this unit\\\\u0027s Defense rolls.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Agile\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Agile\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveActionDeclared\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"actionTypeIs\\\",\\n            \\\"actionType\\\": \\\"Advance\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"movementBonus\\\",\\n            \\\"actionType\\\": \\\"Advance\\\",\\n            \\\"distanceInches\\\": 1,\\n            \\\"minResultInches\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveActionDeclared\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"actionTypeIs\\\",\\n            \\\"actionType\\\": \\\"Rush\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"movementBonus\\\",\\n            \\\"actionType\\\": \\\"Rush\\\",\\n            \\\"distanceInches\\\": 2,\\n            \\\"minResultInches\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveActionDeclared\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"actionTypeIs\\\",\\n            \\\"actionType\\\": \\\"Charge\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"movementBonus\\\",\\n            \\\"actionType\\\": \\\"Charge\\\",\\n            \\\"distanceInches\\\": 2,\\n            \\\"minResultInches\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Moves \\\\u002B1\\\\u0022 when Advancing and \\\\u002B2\\\\u0022 when Rushing or Charging.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Fear(1)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Fear\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Melee_OnMeleeResolution\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"extraMeleeWoundCount\\\",\\n            \\\"amount\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Counts as dealing extra wounds when deciding who won a melee (does not deal real wounds).\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      1\\n    ],\\n    \\\"arguments\\\": [\\n      {\\n        \\\"intValue\\\": 1,\\n        \\\"strValue\\\": null\\n      }\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Strider\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Strider\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveThroughTerrain\\\",\\n        