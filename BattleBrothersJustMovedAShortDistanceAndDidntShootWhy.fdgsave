 \\\"multiplyWounds\\\",\\n            \\\"multiplier\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Each wound from this weapon is multiplied; excess wounds don\\\\u0027t carry over to other models.\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      3\\n    ],\\n    \\\"arguments\\\": [\\n      {\\n        \\\"intValue\\\": 3,\\n        \\\"strValue\\\": null\\n      }\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Limited\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Limited\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Neutral\\\",\\n      \\\"description\\\": \\\"This weapon may only be used once per game.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  }\\n]\",\"Name\":\"Fusion-Mod\",\"RangeInches\":12.0,\"Attacks\":1,\"ArmorPenetration\":4,\"EffectKey\":\"fusion-melta\"},{\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Rending\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Rending\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"unmodifiedRollEquals\\\",\\n            \\\"dieValue\\\": 6\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"perHitSaveModifier\\\",\\n            \\\"onRollValue\\\": 6,\\n            \\\"delta\\\": -4\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n  