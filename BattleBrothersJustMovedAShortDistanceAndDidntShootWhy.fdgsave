      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Ambush\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Ambush\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Deployment_OnPreDeploymentSelect\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"deferDeployment\\\",\\n            \\\"timing\\\": \\\"LaterRound\\\",\\n            \\\"placementRangeInches\\\": 9,\\n            \\\"minArrivalRound\\\": 2,\\n            \\\"mandatoryArrival\\\": false\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Kept in reserve; may arrive from round 2 onward, placed over 9\\\\u0022 from enemy units.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Tough(6)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Tough\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"setMaxWounds\\\",\\n            \\\"amount\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Each model in the uni