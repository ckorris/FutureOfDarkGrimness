      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Caster(3)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Caster\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Round_OnRoundStart\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"grantToken\\\",\\n            \\\"tType\\\": {\\n              \\\"id\\\": \\\"SpellTokens\\\"\\n            },\\n            \\\"count\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            },\\n            \\\"clear\\\": {\\n              \\\"kind\\\": \\\"manualOnly\\\"\\n            },\\n            \\\"maxTotal\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnCapabilityQuery\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"enableCasting\\\"\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"At the start of each round, gains spell tokens to cast spells from its army\\\\u0027s spell list.\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      3\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Fear(1)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Fear\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Melee_OnMeleeResolution\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\":