      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":null,\"RemainingWoundsBinding\":{\"TypeID\":{\"ID\":2},\"Index\":150,\"Generation\":1},\"PositionBinding\":{\"TypeID\":{\"ID\":4},\"Index\":150,\"Generation\":1},\"FacingBinding\":{\"TypeID\":{\"ID\":15},\"Index\":150,\"Generation\":1},\"Weapons\":[{\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Blast(3)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Blast\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"multiplyHits\\\",\\n            \\\"multiplier\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnSaveRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignoreCover\\\"\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Each hit becomes several hits (no more per hit than the target unit\\\\u0027s model count) and the attack ignores cover.\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      3\\n    ],\\n    \\\"arguments\\\": [\\n      {\\n        \\\"intValue\\\": 3,\\n        \\\"strValue\\\": null\\n      }\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Reliable\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Reliable\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"qualityFloor\\\",\\n            \\\"quality\\\": 2\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Attacks with this weapon hit on a Quality of 2\\\\u002B (before other modifiers).\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  }\\n]\",\"Name\":\"Flamer\",\"RangeInches\":12.0,\"Attacks\":1,\"ArmorPenetration\":0,\"EffectKey\":\"flame-jet\"},{\"_ruleDefinitionsJson\":null,\"Name\":\"CCW\",\"RangeInches\":0.0,\"Attacks\":1,\"ArmorPenetration\":0,\"EffectKey\":\"crude-melee\"}],\"ID\":{\"ID\":\"7053c291-3152-43d6-bd91-19a9a9ab3abb\"},\"TotalWounds\":1.0,\"WoundsDealt\":1.0,\"Position\":{\"Position3D\":{\"X\":50.047016,\"Y\":0.0,\"Z\":28.659376,\"XY\":{\"X\":50.047016,\"Y\":0.0},\"XZ\":{\"X\":50.047016,\"Y\":28.659376}},\"Position2D\":{\"X\":50.047016,\"Y\":28.659376},\"x\":50.047016,\"y\":0.0,\"z\":28.659376},\"Facing\":{\"X\":0.0,\"Y\":-1.0},\"BaseShape\":{\"$type\":\"baseShape.circle\",\"RadiusInches\":0.492126,\"BoundingRadiusInches\":0.492126,\"CircumscribedRadiusInches\":0.492126}}"
