\\"This model and its unit get No Retreat.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Protection Feat\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActivationStart\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerGame\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Protection Feat Guard\\\",\\n            \\\"scope\\\": \\\"UntilNextActivation\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\n          },\\n          \\\"label\\\": \\\"Protection Feat\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Once per game, when this unit activates, it may brace: until its next activation it rolls one die per wound it takes, ignoring each on a 5\\\\u002B.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Reanimation\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Activation_OnActivationStart\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"restoreWounds\\\",\\n            \\\"minRoll\\\": 5\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When a unit where all models have this rule is activated, roll as many dice as the max. number of models/wounds it could restore. For each 5\\\\u002B you may restore one model/wound. Note that new models may only be restored if they can be placed in coherency with non-restored models.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"No Retreat\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Morale_OnMoraleTestComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"mostModelsHaveThisRule\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"passFailedMoraleTest\\\",\\n            \\\"selfWoundOnRollAtMost\\\": 3\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When a unit where most models have this rule fails a morale test that causes it to be Shaken or Routed, the test counts as passed instead. Then, roll as many dice as the number of wounds it would take to fully destroy it, and for each result of 1-3 the unit takes one wound, which can\\\\u0027t be ignored.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Protection Feat Guard\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnSaveRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignoreWoundOnRoll\\\",\\n            \\\"minRoll\\\": 5\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Subject\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"This unit rolls one die per wound it takes, ignoring each on a 5\\\\u002B.\\\"\\n    }\\n  ],\\n  \\\"spells\\\": [\\n    {\\n      \\\"name\\\": \\\"Triangulation Bots\\\",\\n      \\\"threshold\\\": 1,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 18,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 1,\\n        \\\"targetAffinity\\\": \\\"Foe\\\",\\n        \\\"requireLineOfSight\\\": false,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"markTarget\\\",\\n        \\\"ruleName\\\": \\\"Indirect when shooting\\\"\\n      }\\n    },\\n    {\\n      \\\"name\\\": \\\"Piercing Bots\\\",\\n      \\\"threshold\\\": 1,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 12,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 1,\\n        \\\"targetAffinity\\\": \\\"Foe\\\",\\n        \\\"requireLineOfSight\\\": true,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"dealHits\\\",\\n        \\\"count\\\": 2,\\n        \\\"withRules\\\": [],\\n        \\\"armorPenetration\\\": 2\\n      }\\n    },\\n    {\\n      \\\"name\\\": \\\"Inspiring Bots\\\",\\n      \\\"threshold\\\": 2,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 12,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 2,\\n        \\\"targetAffinity\\\": \\\"Friend\\\",\\n        \\\"requireLineOfSight\\\": false,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"addRule\\\",\\n        \\\"ruleName\\\": \\\"Rapid Advance\\\",\\n        \\\"scope\\\": \\\"NextTrigger\\\"\\n      }\\n    },\\n    {\\n      \\\"name\\\": \\\"Flame Bots\\\",\\n      \\\"threshold\\\": 2,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 9,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 2,\\n        \\\"targetAffinity\\\": \\\"Foe\\\",\\n        \\\"requireLineOfSight\\\": true,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"dealHits\\\",\\n        \\\"count\\\": 4,\\n        \\\"withRules\\\": [],\\n        \\\"armorPenetration\\\": 0\\n      }\\n    },\\n    {\\n      \\\"name\\\": \\\"Mending Bots\\\",\\n      \\\"threshold\\\": 3,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 12,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 3,\\n        \\\"targetAffinity\\\": \\\"Friend\\\",\\n        \\\"requireLineOfSight\\\": false,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"addRule\\\",\\n        \\\"ruleName\\\": \\\"Self-Repair Boost\\\",\\n        \\\"scope\\\": \\\"NextTrigger\\\"\\n      }\\n    },\\n    {\\n      \\\"name\\\": \\\"Gauss Bots\\\",\\n      \\\"threshold\\\": 3,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 6,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 1,\\n        \\\"targetAffinity\\\": \\\"Foe\\\",\\n        \\\"requireLineOfSight\\\": true,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"dealHits\\\",\\n        \\\"count\\\": 9,\\n        \\\"withRules\\\": [\\n          \\\"Destructive\\\"\\n        ],\\n        \\\"armorPenetration\\\": 0\\n      }\\n    }\\n  ],\\n  \\\"auxiliaryUnits\\\": null,\\n  \\\"defaultRangedEf