      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Tough(3)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Tough\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"setMaxWounds\\\",\\n            \\\"amount\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Each model in the unit has multiple wounds instead of one.\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      3\\n    ],\\n    \\\"arguments\\\": [\\n      {\\n        \\\"intValue\\\": 3,\\n        \\\"strValue\\\": null\\n      }\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Battleborn\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Battleborn\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Round_OnRoundStart\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"and\\\",\\n            \\\"left\\\": {\\n              \\\"kind\\\": \\\"tokenPresent\\\",\\n              \\\"tType\\\": {\\n                \\\"id\\\": \\\"Shaken\\\"\\n              },\\n              \\\"minCount\\\": 1\\n            },\\n            \\\"right\\\": {\\n              \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"clearTokenOnRoll\\\",\\n            \\\"tType\\\": {\\n              \\\"id\\\": \\\"Shaken\\\"\\n            },\\n            \\\"minRoll\\\": 4\\n          },\\n          \\\"lifetime\\\": \\\"ThisRound\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"If this unit is Shaken at the start of the round, roll one die. On a 4\\\\u002B it stops being Shaken.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Fearless\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Fearless\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Morale_OnMoraleTestComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"reroll\\\",\\n            \\\"roll\\\": \\\"Morale\\\",\\n            \\\"condition\\\": {\\n              \\\"kind\\\": \\\"allFailures\\\"\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When this unit fails a morale test, it re-rolls and passes on a 4\\\\u002B.\\\"\\n    },\\n    \\\"intArguments\\\": [],\\n    \\\"arguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Bane when Shooting Aura\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Bane when Shooting Aura\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"aura\\\",\\n            \\\"ruleName\\\": \\\"Bane when shooting\\\"\