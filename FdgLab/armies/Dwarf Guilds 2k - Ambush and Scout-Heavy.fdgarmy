    "ruleDefinitions": [
      {
        "name": "Deceleration Rune Effect",
        "passive": [
          {
            "hookID": "Movement_OnMoveActionDeclared",
            "condition": {
              "kind": "actionTypeIs",
              "actionType": "Advance"
            },
            "effect": {
              "kind": "movementBonus",
              "actionType": "Advance",
              "distanceInches": -2,
              "minResultInches": 0
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          },
          {
            "hookID": "Movement_OnMoveActionDeclared",
            "condition": {
              "kind": "actionTypeIs",
              "actionType": "Rush"
            },
            "effect": {
              "kind": "movementBonus",
              "actionType": "Rush",
              "distanceInches": -4,
              "minResultInches": 0
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          },
          {
            "hookID": "Movement_OnMoveActionDeclared",
            "condition": {
              "kind": "actionTypeIs",
              "actionType": "Charge"
            },
            "effect": {
              "kind": "movementBonus",
              "actionType": "Charge",
              "distanceInches": -4,
              "minResultInches": 0
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Negative",
        "description": "Moves -2\u0022 when using Advance, and -4\u0022 when using Rush/Charge (from Deceleration Rune)."
      },
      {
        "name": "Infiltrate",
        "passive": [
          {
            "hookID": "Deployment_OnPreDeploymentSelect",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "deferDeployment",
              "timing": "LaterRound",
              "placementRangeInches": 3,
              "minArrivalRound": 2,
              "mandatoryArrival": false,
              "enemyClearanceInches": 0
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Counts as having Ambush, but may be deployed anywhere over 3\u0022 away from enemy unit."
      },
      {
        "name": "Melee Slayer",
        "passive": [
          {
            "hookID": "Shooting_OnHitRollComplete",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "isCharging"
              },
              "right": {
                "kind": "targetMajorityHasTough",
                "minToughValue": 3
              }
            },
            "effect": {
              "kind": "rollModifier",
              "rollKind": "Save",
              "delta": -2
            },
            "lifetime": "ThisAttack",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "When charging, this model\u0027s weapons get AP(\u002B2) if most models in the target have Tough(3) or higher."
      },
      {
        "name": "Sturdy",
        "passive": [
          {
            "hookID": "Shooting_OnHitRollComplete",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "attackedFromOver",
                "shootInches": 9,
                "chargeInches": 6
              },
              "right": {
                "kind": "mostModelsHaveThisRule"
              }
            },
            "effect": {
              "kind": "rollModifier",
              "rollKind": "Save",
              "delta": 1
            },
            "lifetime": "ThisAttack",
            "seat": "Subject"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "If most models in this unit have this rule, they get \u002B1 to Defense rolls when shot/charged from over 9\u0022/6\u0022 away."
      },
      {
        "name": "Swift",
        "passive": [
          {
            "hookID": "Movement_OnMoveThroughTerrain",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "ignoreTerrainEffects",
              "scope": "DifficultOnly"
            },
            "lifetime": "ThisActivation",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This model may ignore the Slow rule."
      },
      {
        "name": "Swift Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "aura",
              "ruleName": "Swift"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "This model and its unit get Swift."
      },
      {
        "name": "Infiltrate Aura",
        "passive": [
          {
            "hookID": "Lifecycle_OnUnitCreated",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "aura",
              "ruleName": "Infiltrate"
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
