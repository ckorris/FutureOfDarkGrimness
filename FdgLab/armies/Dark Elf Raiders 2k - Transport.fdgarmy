    "ruleDefinitions": [
      {
        "name": "Infiltrate",
        "passive": [
          {
            "hookID": "Deployment_OnPreDeploymentSelect",
            "condition": {
              "kind": "always"
            },
            "effect": {
              "kind": "deferDeployment",
              "timing": "LaterRound",
              "placementRangeInches": 3,
              "minArrivalRound": 2,
              "mandatoryArrival": false,
              "enemyClearanceInches": 0
            },
            "lifetime": "UntilEndOfGame",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "Counts as having Ambush, but may be deployed anywhere over 3\u0022 away from enemy unit."
      },
      {
        "name": "Melee Slayer",
        "passive": [
          {
            "hookID": "Shooting_OnHitRollComplete",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "isCharging"
              },
              "right": {
                "kind": "targetMajorityHasTough",
                "minToughValue": 3
              }
            },
            "effect": {
              "kind": "rollModifier",
              "rollKind": "Save",
              "delta": -2
            },
            "lifetime": "ThisAttack",
            "seat": "Actor"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "When charging, this model\u0027s weapons get AP(\u002B2) if most models in the target have Tough(3) or higher."
      },
      {
        "name": "Dodge",
        "passive": [
          {
            "hookID": "Shooting_OnHitRollModifier",
            "condition": {
              "kind": "and",
              "left": {
                "kind": "isMelee"
              },
              "right": {
                "kind": "and",
                "left": {
                  "kind": "mostModelsHaveThisRule"
                },
                "right": {
                  "kind": "not",
                  "inner": {
                    "kind": "countsAsFatiguedInMelee"
                  }
                }
              }
            },
            "effect": {
              "kind": "rollModifier",
              "rollKind": "Hit",
              "delta": -1
            },
            "lifetime": "ThisAttack",
            "seat": "Subject"
          }
        ],
        "activated": [],
        "scope": "Unit",
        "engineArgumentCount": 0,
        "valence": "Positive",
        "description": "If most models in this unit have this rule, as long as they aren\u0027t Fatigued, enemy units get -1 to hit rolls in melee against them."
      },
