      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have this rule, they get \u002B1 to Morale Test rolls when shot/charged from over 9\u0022/6\u0022 away."
