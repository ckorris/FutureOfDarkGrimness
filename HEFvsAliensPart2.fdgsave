      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":null,\"RemainingWoundsBinding\":{\"TypeID\":{\"ID\":2},\"Index\":0,\"Generation\":1},\"PositionBinding\":{\"TypeID\":{\"ID\":4},\"Index\":0,\"Generation\":1},\"FacingBinding\":{\"TypeID\":{\"ID\":15},\"Index\":0,\"Generation\":1},\"Weapons\":[{\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Blast(3)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Blast\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"multiplyHits\\\",\\n            \\\"multiplier\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnSaveRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignoreCover\\\"\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Each hit is multiplied (up to the target unit\\\\u0027s model count) and the attack ignores cover.\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      3\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Indirect\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Indirect\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"and\\\",\\n            \\\"left\\\": {\\n              \\\"kind\\\": \\\"afterMoving\\\"\\n            },\\n            \\\"right\\\": {\\n              \\\"kind\\\": \\\"not\\\",\\n              \\\"inner\\\": {\\n                \\\"kind\\\": \\\"isMelee\\\"\\n              }\\n            }\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"rollModifier\\\",\\n            \\\"rollKind\\\": \\\"Hit\\\",\\n            \\\"delta\\\": -1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnSaveRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignoreLineOfSight\\\"\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnSaveRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignoreCover\\\"\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Fires at targets out of line of sight and ignores cover; -1 to hit if the unit moved this activation.\\\"\\n    },\\n    \\\"intArguments\\\": []\\n  }\\n]\",\"Name\":\"Burst Mortar\",\"RangeInches\":30.0,\"Attacks\":2,\"ArmorPenetration\":0},{\"_ruleDefinitionsJson\":null,\"Name\":\"Artillery Crew\",\"RangeInches\":0.0,\"Attacks\":3,\"ArmorPenetration\":0}],\"ID\":{\"ID\":\"7840da92-c181-4db0-9dda-7cf7aed93055\"},\"TotalWounds\":3.0,\"WoundsDealt\":0.0,\"Position\":{\"Position3D\":{\"X\":43.04147,\"Y\":0.0,\"Z\":41.394497,\"XY\":{\"X\":43.04147,\"Y\":0.0},\"XZ\":{\"X\":43.04147,\"Y\":41.394497}},\"Position2D\":{\"X\":43.04147,\"Y\":41.394497},\"x\":43.04147,\"y\":0.0,\"z\":41.394497},\"Facing\":{\"X\":0.0,\"Y\":-1.0},\"BaseShape\":{\"$type\":\"baseShape.circle\",\"RadiusInches\":1.1811024,\"BoundingRadiusInches\":1.1811024,\"CircumscribedRadiusInches\":1.1811024}}"
