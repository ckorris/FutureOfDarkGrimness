      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Caster(3)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Caster\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Round_OnRoundStart\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"grantToken\\\",\\n            \\\"tType\\\": {\\n              \\\"id\\\": \\\"SpellTokens\\\"\\n            },\\n            \\\"count\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            },\\n            \\\"clear\\\": {\\n              \\\"kind\\\": \\\"manualOnly\\\"\\n            },\\n            \\\"maxTotal\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnCapabilityQuery\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"enableCasting\\\"\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"At the start of each round, gains spell tokens to cast spells from its army\\\\u0027s spell list.\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      3\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Fear(1)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Fear\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Melee_OnMeleeResolution\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"extraMeleeWoundCount\\\",\\n            \\\"amount\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Counts as dealing extra wounds when deciding who won a melee (does not deal real wounds).\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      1\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Strider\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Strider\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveThroughTerrain\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"ignoreTerrainEffects\\\",\\n            \\\"scope\\\": \\\"DifficultOnly\\\"\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Ignores the movement penalty for Difficult terrain.\\\"\\n    },\\n    \\\"intArguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Tough(6)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Tough\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"setMaxWounds\\\",\\n            \\\"amount\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Each model in the unit has multiple wounds instead of one.\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      6\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Primal\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Primal\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"unmodifiedRollEquals\\\",\\n            \\\"dieValue\\\": 6\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addExtraHit\\\",\\n            \\\"onRollValue\\\": 6,\\n            \\\"count\\\": 1\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Each unmodified 6 to hit scores an extra hit.\\\"\\n    },\\n    \\\"intArguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Fearless\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Fearless\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Morale_OnMoraleTestComplete\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"allModelsHaveThisRule\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"reroll\\\",\\n            \\\"roll\\\": \\\"Morale\\\",\\n            \\\"condition\\\": {\\n              \\\"kind\\\": \\\"allFailures\\\"\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"When this unit fails a morale test, it re-rolls and passes on a 4\\\\u002B.\\\"\\n    },\\n    \\\"intArguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Primal Boost Buff\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Primal Boost Buff\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnPreAttack\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 12,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Friend\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"addRule\\\",\\n            \\\"ruleName\\\": \\\"Primal Boost\\\",\\n            \\\"scope\\\": \\\"NextTrigger\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Once per activation, before attacking, pick one friendly unit within 12 inches, which gains Primal Boost for its next relevant roll.\\\"\\n    },\\n    \\\"intArguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Disembark\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Disembark\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActionChoice\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"disembark\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"tokenPresent\\\",\\n            \\\"tType\\\": {\\n              \\\"id\\\": \\\"EmbarkedIn\\\"\\n            },\\n            \\\"minCount\\\": 1\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Neutral\\\",\\n      \\\"description\\\": \\\"Leave the transport this unit is embarked in, placing within 6\\\\u0022 of it.\\\"\\n    },\\n    \\\"intArguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Embark\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Embark\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnActionChoice\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 0,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Self\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"embark\\\"\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Neutral\\\",\\n      \\\"description\\\": \\\"Board a friendly transport that has room, within move range.\\\"\\n    },\\n    \\\"intArguments\\\": []\\n  }\\n]\",\"RemainingWoundsBinding\":{\"TypeID\":{\"ID\":2},\"Index\":78,\"Generation\":1},\"PositionBinding\":{\"TypeID\":{\"ID\":4},\"Index\":78,\"Generation\":1},\"FacingBinding\":{\"TypeID\":{\"ID\":15},\"Index\":78,\"Generation\":1},\"Weapons\":[{\"_ruleDefinitionsJson\":null,\"Name\":\"Magic Shock\",\"RangeInches\":18.0,\"Attacks\":3,\"ArmorPenetration\":0,\"EffectKey\":\"gauss-particle\"},{\"_ruleDefinitionsJson\":null,\"Name\":\"Heavy Pulse\",\"RangeInches\":0.0,\"Attacks\":6,\"ArmorPenetration\":0,\"EffectKey\":\"claw-rend\"}],\"ID\":{\"ID\":\"6e1fa39a-23cf-48eb-840c-0790c3fc1c81\"},\"TotalWounds\":6.0,\"WoundsDealt\":0.0,\"Position\":{\"Position3D\":{\"X\":42.74647,\"Y\":0.0,\"Z\":43.339607,\"XY\":{\"X\":42.74647,\"Y\":0.0},\"XZ\":{\"X\":42.74647,\"Y\":43.339607}},\"Position2D\":{\"X\":42.74647,\"Y\":43.339607},\"x\":42.74647,\"y\":0.0,\"z\":43.339607},\"Facing\":{\"X\":0.0,\"Y\":-1.0},\"BaseShape\":{\"$type\":\"baseShape.circle\",\"RadiusInches\":1.1811024,\"BoundingRadiusInches\":1.1811024,\"CircumscribedRadiusInches\":1.1811024}}"
