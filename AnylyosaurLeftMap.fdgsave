 on Advance and \\\\u002B4\\\\u0022 on Rush/Charge from Highborn (instead of only \\\\u002B2\\\\u0022 and \\\\u002B2\\\\u0022).\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Highborn Boost Aura\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"aura\\\",\\n            \\\"ruleName\\\": \\\"Highborn Boost\\\"\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"This model and its whole unit gain Highborn Boost.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Re-Position Artillery\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnPreAttack\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 6,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Friend\\\",\\n            \\\"requireLineOfSight\\\": false,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": \\\"Artillery\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"triggeredMove\\\",\\n            \\\"maxInches\\\": 9,\\n            \\\"isOptional\\\": true\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Once per activation, before attacking, pick one friendly unit within 6\\\\u0022 with Artillery, which may immediately move by up to 9\\\\u0022.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Unique\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Neutral\\\",\\n      \\\"description\\\": \\\"Your army may only include one copy of this unit.\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Piercing Spotter\\\",\\n      \\\"passive\\\": [],\\n      \\\"activated\\\": [\\n        {\\n          \\\"triggerHook\\\": \\\"Activation_OnPreAttack\\\",\\n          \\\"cost\\\": {\\n            \\\"kind\\\": \\\"oncePerActivation\\\"\\n          },\\n          \\\"targetSelector\\\": {\\n            \\\"rangeInches\\\": 30,\\n            \\\"minCount\\\": 1,\\n            \\\"maxCount\\\": 1,\\n            \\\"targetAffinity\\\": \\\"Foe\\\",\\n            \\\"requireLineOfSight\\\": true,\\n            \\\"requiredToken\\\": null,\\n            \\\"singleModel\\\": false,\\n            \\\"requiredRule\\\": null\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"grantTokenOnRoll\\\",\\n            \\\"tType\\\": {\\n              \\\"id\\\": \\\"SpendableApBonusMarker\\\"\\n            },\\n            \\\"count\\\": {\\n              \\\"kind\\\": \\\"literal\\\",\\n              \\\"value\\\": 1\\n            },\\n            \\\"clear\\\": {\\n              \\\"kind\\\": \\\"manualOnly\\\"\\n            },\\n            \\\"minRoll\\\": 4\\n          },\\n          \\\"availableWhen\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"label\\\": \\\"\\\"\\n        }\\n      ],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Once per activation: pick one enemy within 30 inches in line of sight and roll one die; on a 4\\\\u002B place a marker on it. Attackers may remove markers from it before it rolls to block, gaining AP(\\\\u002B1) per removed marker.\\\"\\n    }\\n  ],\\n  \\\"spells\\\": [\\n    {\\n      \\\"name\\\": \\\"Creator of Illusions\\\",\\n      \\\"threshold\\\": 1,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 18,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 1,\\n        \\\"targetAffinity\\\": \\\"Foe\\\",\\n        \\\"requireLineOfSight\\\": false,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"addRule\\\",\\n        \\\"ruleName\\\": \\\"Unwieldy in melee\\\",\\n        \\\"scope\\\": \\\"NextTrigger\\\"\\n      }\\n    },\\n    {\\n      \\\"name\\\": \\\"Elemental Seeker\\\",\\n      \\\"threshold\\\": 1,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 18,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 1,\\n        \\\"targetAffinity\\\": \\\"Foe\\\",\\n        \\\"requireLineOfSight\\\": true,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \\\"kind\\\": \\\"dealHits\\\",\\n        \\\"count\\\": 1,\\n        \\\"withRules\\\": [\\n          \\\"Blast(3)\\\"\\n        ],\\n        \\\"armorPenetration\\\": 0\\n      }\\n    },\\n    {\\n      \\\"name\\\": \\\"Hidden Spirits\\\",\\n      \\\"threshold\\\": 2,\\n      \\\"target\\\": {\\n        \\\"rangeInches\\\": 12,\\n        \\\"minCount\\\": 1,\\n        \\\"maxCount\\\": 2,\\n        \\\"targetAffinity\\\": \\\"Friend\\\",\\n        \\\"requireLineOfSight\\\": false,\\n        \\\"requiredToken\\\": null,\\n        \\\"singleModel\\\": false,\\n        \\\"requiredRule\\\": null\\n      },\\n      \\\"effect\\\": {\\n        \