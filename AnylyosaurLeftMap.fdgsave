me\\\": \\\"Reliable\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Reliable\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Shooting_OnHitRollModifier\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"qualityFloor\\\",\\n            \\\"quality\\\": 2\\n          },\\n          \\\"lifetime\\\": \\\"ThisAttack\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Weapon\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Attacks with this weapon hit on a Quality of 2\\\\u002B (before other modifiers).\\\"\\n    },\\n    \\\"intArguments\\\": []\\n  }\\n]\",\"Name\":\"Scoped Rifle\",\"RangeInches\":30.0,\"Attacks\":1,\"ArmorPenetration\":1,\"EffectKey\":\"laser-beam\"},{\"_ruleDefinitionsJson\":null,\"Name\":\"CCW\",\"RangeInches\":0.0,\"Attacks\":1,\"ArmorPenetration\":0,\"EffectKey\":\"energy-blade\"}],\"ID\":{\"ID\":\"0e70d9c1-17cb-416e-873a-af5cdbf322a3\"},\"TotalWounds\":1.0,\"WoundsDealt\":1.0,\"Position\":{\"Position3D\":{\"X\":49.7654,\"Y\":0.0,\"Z\":24.890734,\"XY\":{\"X\":49.7654,\"Y\":0.0},\"XZ\":{\"X\":49.7654,\"Y\":24.890734}},\"Position2D\":{\"X\":49.7654,\"Y\":24.890734},\"x\":49.7654,\"y\":0.0,\"z\":24.890734},\"Facing\":{\"X\":0.43666777,\"Y\":0.89962286},\"BaseShape\":{\"$type\":\"baseShape.circle\",\"RadiusInches\":0.492126,\"BoundingRadiusInches\":0.492126,\"CircumscribedRadiusInches\":0.492126}}"
