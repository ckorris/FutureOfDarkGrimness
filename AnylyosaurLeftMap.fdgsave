      "JsonValue": "{\"_tokens\":{\"_tokens\":[]},\"_ruleDefinitionsJson\":\"[\\n  {\\n    \\\"requestedName\\\": \\\"Tough(3)\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Tough\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Lifecycle_OnUnitCreated\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"setMaxWounds\\\",\\n            \\\"amount\\\": {\\n              \\\"kind\\\": \\\"arg\\\",\\n              \\\"index\\\": 0\\n            }\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Each model in the unit has multiple wounds instead of one.\\\"\\n    },\\n    \\\"intArguments\\\": [\\n      3\\n    ]\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Highborn\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Highborn\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveActionDeclared\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"actionTypeIs\\\",\\n            \\\"actionType\\\": \\\"Advance\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"movementBonus\\\",\\n            \\\"actionType\\\": \\\"Advance\\\",\\n            \\\"distanceInches\\\": 2,\\n            \\\"minResultInches\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveActionDeclared\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"actionTypeIs\\\",\\n            \\\"actionType\\\": \\\"Rush\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"movementBonus\\\",\\n            \\\"actionType\\\": \\\"Rush\\\",\\n            \\\"distanceInches\\\": 2,\\n            \\\"minResultInches\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        },\\n        {\\n          \\\"hookID\\\": \\\"Movement_OnMoveActionDeclared\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"actionTypeIs\\\",\\n            \\\"actionType\\\": \\\"Charge\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"movementBonus\\\",\\n            \\\"actionType\\\": \\\"Charge\\\",\\n            \\\"distanceInches\\\": 2,\\n            \\\"minResultInches\\\": 0\\n          },\\n          \\\"lifetime\\\": \\\"ThisActivation\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"description\\\": \\\"Moves \\\\u002B2\\\\u0022 when using Advance, and \\\\u002B2\\\\u0022 when using Rush/Charge.\\\"\\n    },\\n    \\\"intArguments\\\": []\\n  },\\n  {\\n    \\\"requestedName\\\": \\\"Ambush\\\",\\n    \\\"definition\\\": {\\n      \\\"name\\\": \\\"Ambush\\\",\\n      \\\"passive\\\": [\\n        {\\n          \\\"hookID\\\": \\\"Deployment_OnPreDeploymentSelect\\\",\\n          \\\"condition\\\": {\\n            \\\"kind\\\": \\\"always\\\"\\n          },\\n          \\\"effect\\\": {\\n            \\\"kind\\\": \\\"deferDeployment\\\",\\n            \\\"timing\\\": \\\"LaterRound\\\",\\n            \\\"placementRangeInches\\\": 9\\n          },\\n          \\\"lifetime\\\": \\\"UntilEndOfGame\\\",\\n          \\\"seat\\\": \\\"Actor\\\"\\n        }\\n      ],\\n      \\\"activated\\\": [],\\n      \\\"scope\\\": \\\"Unit\\\",\\n      \\\"engineArgumentCount\\\": 0,\\n      \\\"valence\\\": \\\"Positive\\\",\\n      \\\"descri